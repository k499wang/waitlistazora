# Supabase (legacy waitlist path)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase auth / SSR (web checkout). Anon URL+key are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# RevenueCat Web Purchase Links (server-only — do NOT prefix with NEXT_PUBLIC_).
# Sandbox links are used in every non-production environment.
REVENUECAT_WEB_PURCHASE_LINK_ANNUAL_SANDBOX="https://pay.rev.cat/sandbox/onqkikrjlwnxfpsb"
REVENUECAT_WEB_PURCHASE_LINK_WEEKLY_SANDBOX="https://pay.rev.cat/sandbox/plvwmjvsuochpfot"

# Production links are not available yet. Leave blank until RevenueCat provides
# them; production checkout fails loudly if these are missing.
REVENUECAT_WEB_PURCHASE_LINK_ANNUAL_PROD=""
REVENUECAT_WEB_PURCHASE_LINK_WEEKLY_PROD=""

# RevenueCat Web Billing PUBLIC API key (rcb_...). Browser-safe; used only to
# READ offerings so the pricing UI shows real prices. Optional — the UI falls
# back to hardcoded display prices when this is unset.
NEXT_PUBLIC_REVENUECAT_BILLING_KEY=""

# Embedded on-domain checkout via the RevenueCat Web Billing SDK. "true" runs the
# whole purchase on this site; anything else falls back to the pay.rev.cat
# redirect (POST /checkout/start). In production this requires a NON-sandbox
# billing key (rcb_... without the "sb_") so the SDK emits PRODUCTION events that
# match web_checkout_intents.environment.
NEXT_PUBLIC_EMBEDDED_CHECKOUT="true

# Meta / Facebook
# Pixel ID for browser-side PageView + upper-funnel events. Exposed to browser.
# CAPI access token is server-only (do NOT prefix with NEXT_PUBLIC_).
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""
# "true" lets the success page fire the browser Purchase/StartTrial pixel for
# SANDBOX purchases too (normally production-only). Testing only — browse via
# the Events Manager Test Events tab and unset this when done.
NEXT_PUBLIC_META_SANDBOX_PIXEL=""
